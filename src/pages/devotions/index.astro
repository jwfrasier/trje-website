---
import Layout from "../../layouts/Layout.astro";
import "../../styles/devotions.css";
import { getPublishedDevotions, formatDate, isoDate } from "../../lib/devotions";
import { SITE } from "../../lib/site";

const devotions = await getPublishedDevotions();
const [latest, ...rest] = devotions;
---

<Layout
  title="Questions: The Real Jesus Experience"
  description="Bring us your questions about faith, God, and the Bible. We're here for them, and we're happy to share our perspective."
  ogTitle="Questions: The Real Jesus Experience"
  ogDescription="Bring us your questions about faith, God, and the Bible. We're happy to share our perspective."
  ogUrl="https://therealjesusexperience.com/devotions"
  canonicalUrl="https://therealjesusexperience.com/devotions"
  activeRoute="devotions"
>
  <section class="dev-hero" aria-labelledby="dev-hero-h">
    <div class="wide dev-hero-inner">
      <p class="label label-red">Questions</p>
      <h1 id="dev-hero-h" class="display dev-hero-line">Bring us your questions.</h1>
      <p class="dev-hero-sub">
        Wrestling with something about faith, God, or the Bible? We're here
        for your questions, and we're happy to share our perspective. No
        question is too big, too small, or too honest.
      </p>
    </div>
  </section>

  <section class="dev-list-wrap" aria-labelledby="dev-list-h">
    <div class="wide">
      <h2 id="dev-list-h" class="visually-hidden">All devotions</h2>

      {devotions.length === 0 ? (
        <div class="dev-ask">
          <p class="dev-empty">Send us what's on your mind. We read every message.</p>
          <a class="btn" href={`mailto:${SITE.contactEmail}?subject=A question for TRJE`}>
            Ask a question <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      ) : (
        <>
          <a class={`dev-feature${rest.length ? "" : " dev-feature--solo"}`} href={`/devotions/${latest.slug}`}>
            <span class="label label-red">Latest</span>
            <span class="dev-feature-title headline">{latest.data.title}</span>
            <span class="dev-meta">
              <time datetime={isoDate(latest.data.date)}>{formatDate(latest.data.date)}</time>
              {latest.data.scripture && <span class="dev-meta-sep" aria-hidden="true">·</span>}
              {latest.data.scripture && <span>{latest.data.scripture}</span>}
            </span>
            {latest.data.summary && <span class="dev-feature-summary">{latest.data.summary}</span>}
            <span class="dev-read">Read it <span class="arrow" aria-hidden="true">→</span></span>
          </a>

          {rest.length > 0 && (
            <ol class="dev-list" reversed>
              {rest.map((d) => (
                <li>
                  <a class="dev-item" href={`/devotions/${d.slug}`}>
                    <span class="dev-meta">
                      <time datetime={isoDate(d.data.date)}>{formatDate(d.data.date)}</time>
                      {d.data.scripture && <span class="dev-meta-sep" aria-hidden="true">·</span>}
                      {d.data.scripture && <span>{d.data.scripture}</span>}
                    </span>
                    <span class="dev-item-title">{d.data.title} <span class="arrow" aria-hidden="true">→</span></span>
                    {d.data.summary && <span class="dev-item-summary">{d.data.summary}</span>}
                  </a>
                </li>
              ))}
            </ol>
          )}
        </>
      )}
    </div>
  </section>
</Layout>
