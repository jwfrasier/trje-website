---
import Layout from "../layouts/Layout.astro";
import "../styles/resources.css";
import "../styles/anim-resources.css";
import { CATEGORIES, type Block } from "../data/start-here";

const isList = (b: Block): b is { list: string[] } => typeof b !== "string";
---

<Layout
  title="Start Here: The Real Jesus Experience"
  description="New to the Bible, or never felt comfortable opening it? Plain answers to the foundational questions: what the Bible is, the Old and New Testaments, the people in it, salvation, and the Trinity."
  ogTitle="Start Here — The Real Jesus Experience"
  ogDescription="There is a lot going on in the Bible. Plain answers to the foundational questions that help us all get more comfortable with this ancient book."
  ogUrl="https://therealjesusexperience.com/resources"
  canonicalUrl="https://therealjesusexperience.com/resources"
  activeRoute="resources"
>
  <!-- ── HERO (drenched dark) ── -->
  <section class="res-hero" aria-labelledby="res-hero-h">
    <div class="wide res-hero-inner">
      <p class="label label-red">Start here</p>
      <h1 id="res-hero-h" class="display res-hero-line">
        We’re so glad you’re here!
      </h1>
      <p class="res-hero-sub">
        Let’s be real; there is a LOT going on in the Bible. So, let’s answer
        some of those foundational questions that help us all get a little more
        comfortable with this ancient book.
      </p>
    </div>
  </section>

  <!-- ── STICKY CATEGORY JUMP NAV (ivory) ── -->
  <nav class="res-jump" aria-label="Jump to a topic">
    <div class="wide res-jump-inner">
      {CATEGORIES.map((cat) => (
        <a href={`#${cat.id}`}>{cat.title}</a>
      ))}
    </div>
  </nav>

  <!-- ── CATEGORY SECTIONS (alternating dark/ivory) ── -->
  {CATEGORIES.map((cat, i) => {
    const dark = i % 2 === 0;
    const blocks = (body: Block[]) =>
      body.map((b) =>
        isList(b) ? (
          <ul>{b.list.map((li) => <li>{li}</li>)}</ul>
        ) : (
          <p>{b}</p>
        )
      );
    return (
      <section
        id={cat.id}
        class={`res-cat ${dark ? "res-cat--dark" : "res-cat--light"}`}
        aria-labelledby={`${cat.id}-h`}
      >
        <div class="wide res-split">
          <div class="res-cat-head res-anim" data-res="anim">
            <p class="label label-red">{String(i + 1).padStart(2, "0")}</p>
            <h2 id={`${cat.id}-h`} class="headline res-cat-h">{cat.title}</h2>
          </div>

          <div class="res-cat-body">
            <div class="res-copy res-intro">{blocks(cat.intro)}</div>

            {cat.items && (
              <div class="res-items">
                {cat.itemsLabel && (
                  <span class="label label-red res-side-label">{cat.itemsLabel}</span>
                )}
                {cat.display === "open"
                  ? cat.items.map((item) => (
                      <div class="res-open">
                        <h3 class="res-q-text">{item.heading}</h3>
                        <div class="res-copy">{blocks(item.body)}</div>
                      </div>
                    ))
                  : cat.items.map((item) => (
                      <details class="res-q">
                        <summary>
                          <h3 class="res-q-text">{item.heading}</h3>
                          <span class="res-q-mark" aria-hidden="true"></span>
                        </summary>
                        <div class="res-copy res-q-body">{blocks(item.body)}</div>
                      </details>
                    ))}
              </div>
            )}

            {cat.outro && <div class="res-copy res-outro">{blocks(cat.outro)}</div>}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ── CONTACT (drenched dark) ── -->
  <section class="contact" id="contact" aria-labelledby="contact-heading">
    <div class="wide contact-inner">
      <p class="label label-red" id="contact-heading">Write to us</p>
      <p class="prose" style="max-width: 38rem; color: var(--color-ink-on-dark);">
        Have a question we did not answer here? Ask it. No question is too
        basic, and we read everything.
      </p>
      <a class="contact-email" href="mailto:hello@therealjesusexperience.com">
        hello@therealjesusexperience.com
      </a>
      <ul class="contact-socials" aria-label="Social channels">
        <li><a href="https://www.instagram.com/the_real_jesus_experience" target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href="https://www.youtube.com/@TheRealJesusExperience" target="_blank" rel="noopener noreferrer">YouTube</a></li>
        <li><a href="https://www.facebook.com/TheRealJesusExperience" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        <li><a href="https://www.tiktok.com/@the.real.jesus.exp" target="_blank" rel="noopener noreferrer">TikTok</a></li>
      </ul>
    </div>
  </section>

  <script>
    // Start Here page behavior. Accordions are native <details>, so they work
    // with JS off. Scroll reveals are motion and stay behind the .has-anim guard.
    const root = document.documentElement;

    // Keep the sticky jump nav docked just below the main site nav.
    const siteNav = document.getElementById("site-nav");
    const jump = document.querySelector<HTMLElement>(".res-jump");
    const dockJump = () => {
      if (siteNav && jump) jump.style.top = `${siteNav.offsetHeight}px`;
    };
    dockJump();
    window.addEventListener("resize", dockJump);

    // Scroll reveals (motion only).
    if (root.classList.contains("has-anim")) {
      import("gsap").then(({ gsap }) => {
        import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
          gsap.registerPlugin(ScrollTrigger);
          document.querySelectorAll<HTMLElement>('[data-res="anim"]').forEach((el) => {
            ScrollTrigger.create({
              trigger: el,
              start: "top 88%",
              once: true,
              onEnter: () => {
                gsap.to(el, {
                  opacity: 1,
                  y: 0,
                  duration: 0.7,
                  ease: "expo.out",
                  onComplete: () => (el.style.willChange = "auto"),
                });
              },
            });
          });
        });
      });
    }
  </script>
</Layout>
